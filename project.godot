[application]

config/name="penalty game test"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://scripts/settings_manager.gd"
SoundManager="*res://scripts/sound_manager.gd"
SimpleGrass="*uid://bfq0snth8sj3h"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/simplegrasstextured/plugin.cfg")

